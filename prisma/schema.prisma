generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id         String    @id @default(uuid())
  nome       String    @db.VarChar(100)
  cnpj       String    @unique @db.VarChar(14)
  ativo      Boolean   @default(true)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  usuarios         Usuario[]
  assinaturas      Assinatura[]
  solicitacoes     SolicitacaoCreativo[]
  transacoes_token TransacaoToken[]

  @@index([cnpj])
  @@map("empresas")
}

model Plano {
  id             String    @id @default(uuid())
  nome           String    @db.VarChar(100)
  descricao      String?   @db.Text
  tokens_mensais Int
  preco          Decimal   @db.Decimal(10, 2)
  ativo          Boolean   @default(true)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  deleted_at     DateTime?

  assinaturas Assinatura[]

  @@map("planos")
}

model Assinatura {
  id           String           @id @default(uuid())
  empresa_id   String
  plano_id     String
  tokens_saldo Int              @default(0)
  status       StatusAssinatura @default(ATIVA)
  data_inicio  DateTime         @default(now())
  data_fim     DateTime?
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt
  deleted_at   DateTime?

  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  plano   Plano   @relation(fields: [plano_id], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([data_inicio])
  @@map("assinaturas")
}

model Usuario {
  id         String      @id @default(uuid())
  nome       String      @db.VarChar(100)
  email      String      @unique @db.VarChar(255)
  role       RoleUsuario @default(USER)
  ativo      Boolean     @default(true)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  deleted_at DateTime?

  empresa_id String
  empresa    Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  solicitacoes SolicitacaoCreativo[]

  @@index([email])
  @@map("usuarios")
}

model SolicitacaoCreativo {
  id           String            @id @default(uuid())
  usuario_id   String
  empresa_id   String
  objetivo     String?
  data         DateTime
  formato      Formato
  tokens_usado Int               @default(1)
  status       StatusSolicitacao @default(PROCESSANDO)
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt
  deleted_at   DateTime?

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([created_at])
  @@index([formato])
  @@map("solicitacoes_creativos")
}

model TransacaoToken {
  id            String        @id @default(uuid())
  empresa_id    String
  tipo          TipoTransacao
  quantidade    Int
  saldo_antes   Int
  saldo_depois  Int
  descricao     String?       @db.Text
  referencia_id String?
  created_at    DateTime      @default(now())
  deleted_at    DateTime?

  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([tipo])
  @@map("transacoes_tokens")
}

enum StatusAssinatura {
  ATIVA
  SUSPENSA
  CANCELADA
  EXPIRADA
}

enum RoleUsuario {
  ADMIN
  USER
}

enum Formato {
  STORY
  FEED
  REELS
}

enum StatusSolicitacao {
  PROCESSANDO
  CONCLUIDA
  ERRO
  CANCELADA
}

enum TipoTransacao {
  CREDITO
  DEBITO
  RECARGA
}
